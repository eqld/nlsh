{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug nlsh",
      "type": "debugpy",
      "request": "launch",
      "module": "nlsh.main",
      "args": ["Find all text files in the current directory"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug nlsh (verbose)",
      "type": "debugpy",
      "request": "launch",
      "module": "nlsh.main",
      "args": ["-v", "List running processes"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug nlsh (print only)",
      "type": "debugpy",
      "request": "launch",
      "module": "nlsh.main",
      "args": ["-p", "List running processes"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug nlgc",
      "type": "debugpy",
      "request": "launch",
      "module": "nlsh.git_commit",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug nlt",
      "type": "debugpy",
      "request": "launch",
      "module": "nlsh.token_count",
      "args": ["-f", "README.md"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}

